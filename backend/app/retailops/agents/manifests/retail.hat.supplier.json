{
  "manifest_version": "1.0.0",
  "agent_id": "retail.hat.supplier",
  "kind": "hat",
  "display_name": "Supplier & Merchandising Hat",
  "discipline": "supplier",
  "extends": "retail.base",
  "summary": "Supplier reliability, OTIF/fill-rate risk, and merchandising signals that affect reorder and assortment.",
  "activation": {
    "mode": "hybrid",
    "default_enabled": true,
    "triggers": [
      {
        "type": "intent",
        "value": "supplier"
      },
      {
        "type": "keyword",
        "value": "supplier"
      },
      {
        "type": "keyword",
        "value": "vendor"
      },
      {
        "type": "keyword",
        "value": "otif"
      },
      {
        "type": "keyword",
        "value": "fill rate"
      },
      {
        "type": "keyword",
        "value": "lead time"
      }
    ],
    "put_off_by": [
      "disable:supplier",
      "disable:retail.hat.supplier"
    ]
  },
  "context_sources": [
    {
      "source_id": "supplier_docs",
      "kind": "project_documents",
      "doc_roles": [
        "supplier",
        "document"
      ],
      "description": "Supplier notices and fulfillment-related docs"
    },
    {
      "source_id": "supplier_learning",
      "kind": "learning_profiles",
      "modules": [
        "supplier_fulfilment"
      ],
      "description": "Verified supplier reliability profiles"
    }
  ],
  "allowed_paths": [
    "fixtures/demo/**"
  ],
  "allowed_actions": [
    "retail.analyse_inventory_risk",
    "retail.get_learning_summary"
  ],
  "handoffs": [
    {
      "to_agent_id": "retail.hat.inventory",
      "when": "fulfillment reliability changes reorder quantity or safety stock",
      "carry": [
        "sku",
        "store",
        "supplier_signal"
      ],
      "requires_confirmation": false
    },
    {
      "to_agent_id": "retail.hat.accounting",
      "when": "supplier issues create cost or cash-impact concerns",
      "carry": [
        "sku",
        "cost_impact"
      ],
      "requires_confirmation": false
    }
  ],
  "memory": {
    "scope": "tenant_project",
    "save": [
      {
        "key": "confirmed_lead_time_override",
        "description": "Manager-confirmed supplier lead-time override days",
        "requires_confirmation": true
      }
    ],
    "never_persist": [
      "llm_raw_text",
      "secrets",
      "unverified_claims"
    ]
  },
  "verification": {
    "grounding": "documents_or_learning_only",
    "cite_required": true,
    "refuse_unaided_figures": true,
    "checks": [
      "supplier_signal_before_override"
    ]
  },
  "failure_policy": {
    "on_missing_context": "dependency_required",
    "on_unregistered_action": "unsupported",
    "on_low_confidence": "disclose_only"
  },
  "permissions": [
    "retail:read",
    "retail:analyse"
  ],
  "catalog": {
    "vendor_neutral": true,
    "product": "TEKsystems RetailOps",
    "tags": [
      "hat",
      "supplier",
      "merchandising",
      "fulfillment"
    ]
  },
  "playbook": {
    "formulas": [
      {
        "id": "supplier.otif",
        "name": "On-time in-full rate",
        "expression": "otif_pct = count(on_time AND in_full) / sample_count",
        "inputs": [
          "on_time_flags",
          "in_full_flags",
          "sample_count"
        ],
        "outputs": [
          "otif_percentage"
        ],
        "implemented_by": "learning.supplier_fulfilment",
        "unit": "ratio",
        "notes": ""
      },
      {
        "id": "supplier.fill_rate",
        "name": "Fill rate",
        "expression": "fill_rate = received_units / max(ordered_units, epsilon)",
        "inputs": [
          "received_units",
          "ordered_units"
        ],
        "outputs": [
          "fill_rate"
        ],
        "implemented_by": "learning.supplier_fulfilment",
        "unit": "ratio",
        "notes": ""
      },
      {
        "id": "supplier.reliability_class",
        "name": "Supplier reliability class",
        "expression": "reliable if on_time>=0.9 and otif>=0.85 and fill_rate>=0.95; watch if on_time>=0.75 and otif>=0.7 and fill_rate>=0.85; else at_risk",
        "inputs": [
          "on_time_pct",
          "otif_pct",
          "fill_rate"
        ],
        "outputs": [
          "reliability_classification"
        ],
        "implemented_by": "learning.supplier_fulfilment",
        "unit": null,
        "notes": ""
      }
    ],
    "standards": [
      {
        "id": "supplier.signal_before_override",
        "name": "Supplier signal before lead-time override",
        "kind": "internal",
        "ref": "",
        "must_cite": true,
        "description": "Lead-time overrides require fulfillment evidence plus confirmation."
      },
      {
        "id": "supplier.learning_advisory",
        "name": "Supplier learning advisory",
        "kind": "kpi",
        "ref": "",
        "must_cite": true,
        "description": "Reliability profiles are advisory until an inventory action applies them."
      }
    ],
    "procedures": [
      {
        "id": "supplier.reliability_review",
        "name": "Supplier reliability review",
        "steps": [
          {
            "step": 1,
            "action": "Pull supplier_fulfilment learning profiles and notices",
            "requires_confirmation": false
          },
          {
            "step": 2,
            "action": "Report OTIF, fill rate, reliability class with confidence",
            "requires_confirmation": false
          },
          {
            "step": 3,
            "action": "If reliability affects ROP/safety stock, hand off to inventory",
            "requires_confirmation": false
          }
        ],
        "trigger": "supplier, OTIF, or lead-time question",
        "handoff_to": "retail.hat.inventory",
        "requires_confirmation": false
      },
      {
        "id": "supplier.lead_time_override",
        "name": "Confirm lead-time override",
        "steps": [
          {
            "step": 1,
            "action": "Show current vs proposed lead time with evidence",
            "requires_confirmation": false
          },
          {
            "step": 2,
            "action": "Obtain confirmation",
            "requires_confirmation": true
          },
          {
            "step": 3,
            "action": "Save confirmed_lead_time_override",
            "requires_confirmation": false
          }
        ],
        "trigger": "manager overrides supplier lead time",
        "handoff_to": null,
        "requires_confirmation": true
      }
    ]
  }
}
